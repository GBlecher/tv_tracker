# Copy this file to .env.local and fill in the values from your Supabase project, then restart `npx expo start`.
# Find them via the "Connect" button at the top of the project dashboard, or Project Settings > API Keys
# (use the Publishable key, sb_publishable_..., never a Secret key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
